/*------------------------------------------------------------------*/
/* Check effective dataset access through the configured SAF helper */
/* Returns NONE, READ, UPDATE, CONTROL, ALTER, UNPROTECTED, or N/A  */
/*------------------------------------------------------------------*/
CheckDatasetAccess: PROCEDURE EXPOSE accessProgram accessProgramState
  PARSE UPPER ARG dataset, volume
  PARSE SOURCE . . . . . . . accessEnvironment .

  IF STRIP(accessProgram) == '' THEN RETURN 'N/A'
  IF accessEnvironment == 'OMVS' THEN RETURN 'N/A'
  IF accessProgramState == 'UNAVAILABLE' THEN RETURN 'N/A'
  dataset = STRIP(dataset)
  volume = STRIP(volume)
  IF dataset == '' THEN RETURN 'N/A'
  IF volume == '-' | volume == 'SMS' | volume == '*CATLG' THEN
    volume = ''

  program = STRIP(accessProgram, 'B', "'")
  IF accessProgramState == 'UNKNOWN' THEN DO
    programStatus = SYSDSN("'"program"'")
    IF programStatus \== 'OK' THEN DO
      accessProgramState = 'UNAVAILABLE'
      RETURN 'N/A'
    END
    accessProgramState = 'READY'
  END

  parm = 'DATASET' dataset
  IF volume \== '' THEN parm = parm volume

  ADDRESS 'TSO'
  trapRc = OUTTRAP('accessOut.')
  "CALL '"program"' '"parm"'"
  callRc = RC
  trapRc = OUTTRAP('OFF')

  SELECT
    WHEN callRc == 0 THEN RETURN 'NONE'
    WHEN callRc == 4 THEN RETURN 'READ'
    WHEN callRc == 8 THEN RETURN 'UPDATE'
    WHEN callRc == 12 THEN RETURN 'CONTROL'
    WHEN callRc == 16 THEN RETURN 'ALTER'
    WHEN callRc == 20 THEN RETURN 'UNPROTECTED'
    OTHERWISE RETURN 'N/A'
  END

/*------------------------------------------------------------------*/
/* Return true for effective READ or greater access                 */
/*------------------------------------------------------------------*/
AccessAtLeastRead: PROCEDURE
  PARSE UPPER ARG access
RETURN access == 'READ' | access == 'UPDATE' |,
  access == 'CONTROL' | access == 'ALTER' | access == 'UNPROTECTED'

/*------------------------------------------------------------------*/
/* Check dataset access and track effective-access findings         */
/* Returns: formatted output string for display                     */
/* Parameters:                                                      */
/*   dataset - Dataset name to check                               */
/*   volume  - Volume name for display                             */
/*   missing - Missing status for display                          */
/*   checkRead - If 1, READ access is also a finding (default 0)   */
/*------------------------------------------------------------------*/
CheckAndReportDatasetAccess: PROCEDURE EXPOSE warningDatasets,
  excessiveUaccDatasets excessiveAccessDatasets accessProgram,
  accessProgramState
  PARSE ARG dataset, volume, missing, checkRead

  /* Default checkRead to 0 if not specified */
  IF checkRead == '' THEN checkRead = 0

  access = CheckDatasetAccess(STRIP(dataset), volume)
  accessDisp = LEFT(access, 11)

  IF volume == '' & missing == '' THEN
    output = accessDisp '|' STRIP(dataset)
  ELSE
    output = LEFT(STRIP(volume),6) '|' STRIP(LEFT(missing,6)),
      '|' accessDisp '|' STRIP(dataset)

  dsName = STRIP(dataset)
  excessive = access == 'UPDATE' | access == 'CONTROL' |,
    access == 'ALTER' | access == 'UNPROTECTED'
  IF checkRead == 1 & access == 'READ' THEN excessive = 1
  IF excessive THEN DO
    IF excessiveAccessDatasets == '' THEN
      excessiveAccessDatasets = ' ' || dsName
    ELSE
      excessiveAccessDatasets = excessiveAccessDatasets ||,
        ', ' || dsName
  END

RETURN output

