/*------------------------------------------------------------------*/
/* Enumerate executing job name                                     */
/*------------------------------------------------------------------*/
EnumJobname: PROCEDURE EXPOSE prgname space

  CALL PrintSectionBanner 'Execution Context'
  cvt = GetPtr(16)
  tcbp = GetPtr(cvt)
  tcb = GetPtr(tcbp+4)
  tiot = GetPtr(tcb+12)
  jobname = STRIP(GetStorage(tiot, 8))
  stepname = STRIP(GetStorage(tiot+8, 8))
  procstep = STRIP(GetStorage(tiot+16, 8))
  ascb = GetPtr(X2D('224'))
  asid = 0
  owner = ''
  IF ascb \== 0 THEN DO
    asid = C2D(GetStorage(ascb+36, 2))
    owner = STRIP(GetUserid(ascb))
  END
  IF owner == '' THEN owner = USERID()
  terminal = 'N/A'
  account = 'N/A'
  IF space \== 'OMVS' & ascb \== 0 THEN DO
    terminal = STRIP(SYSVAR('SYSTERMID'))
    asxb = GetPtr(ascb+108)
    IF asxb \== 0 THEN DO
      lwa = GetPtr(asxb+20)
      IF lwa \== 0 THEN DO
        accountData = GetStorage(lwa+400, 40)
        nullAt = POS('00'x, accountData)
        IF nullAt > 0 THEN accountData = LEFT(accountData, nullAt-1)
        account = STRIP(accountData)
      END
    END
  END
  IF terminal == '' THEN terminal = 'N/A'
  IF account == '' THEN account = 'N/A'

  SAY 'Executing from:' prgname
  SAY 'User ID:' owner
  SAY 'Account:' account
  SAY 'Terminal:' terminal
  SAY 'ASID:' asid
  SAY 'Job/session:' jobname
  SAY 'Step:' stepname
  SAY 'Procedure step:' procstep
RETURN

/*------------------------------------------------------------------*/
/* Enumerate logged on users (TSO/OMVS/Started Tasks/Jobs)         */
/*------------------------------------------------------------------*/
EnumUsers: PROCEDURE EXPOSE (globalvars)

  CALL PrintSectionBanner 'Logged On Users'
  cvt = GetPtr(16)
  asvt = GetPtr(cvt+556) + 512
  asvtMaxu = GetPtr(asvt+4)

  /* Initialize arrays */
  tsoUsers.0 = 0
  tsoUsersOwners.0 = 0
  tasks.0 = 0
  tasksUsers.0 = 0
  omvs.0 = 0
  omvsUsers.0 = 0
  jobs.0 = 0
  jobsUsers.0 = 0
  system.0 = 0

  /* Iterate through address spaces */
  DO i = 0 TO asvtMaxu - 1
    ascb = GetStorage(asvt+16+(i*4), 4)

    /* Check if address space is in use */
    IF BITAND(ascb, '80000000'x) == '00000000'x THEN DO
      ascb = C2D(ascb)
      cscb = GetPtr(ascb+56)
      chtrkid = GetStorage(cscb+28, 1)
      ascbjbni = GetPtr(ascb+172)
      ascbjbns = GetPtr(ascb+176)
      asxb = GetPtr(ascb+108)
      ascboucb = GetPtr(ascb+144)
      oucbsubn = GetStorage(ascboucb+176, 4)
      oucbtrxn = GetStorage(ascboucb+200, 8)
      oucbusrd = GetStorage(ascboucb+208, 8)

      /* Started task */
      IF ascbjbns <> 0 & chtrkid == '02'x THEN DO
        usid = GetUserid(ascb)
        CALL AddToArray 'tasks', GetStorage(ascbjbns, 8)
        CALL AddToArray 'tasksUsers', usid
      END

      /* TSO user */
      IF ascbjbns <> 0 & chtrkid == '01'x THEN DO
        usid = GetUserid(ascb)
        CALL AddToArray 'tsoUsers', GetStorage(ascbjbns, 8)
        CALL AddToArray 'tsoUsersOwners', usid
      END

      /* System */
      IF ascbjbns <> 0 & chtrkid == '04'x THEN DO
        CALL AddToArray 'system', GetStorage(ascbjbns, 8)
      END

      /* OMVS user */
      IF STRIP(oucbsubn) == 'OMVS' THEN DO
        CALL AddToArray 'omvs', oucbtrxn
        CALL AddToArray 'omvsUsers', oucbusrd
      END

      /* Batch job */
      IF ascbjbni <> 0 & chtrkid == '03'x THEN DO
        IF STRIP(oucbsubn) == 'OMVS' THEN ITERATE
        usid = GetUserid(ascb)
        CALL AddToArray 'jobs', GetStorage(ascbjbni, 8)
        CALL AddToArray 'jobsUsers', usid
      END
    END
  END

  /* Display results */
  SAY '**** Started Tasks - Owner ****'
  DO i = 1 TO tasks.0
    SAY tasks.i '-' tasksUsers.i
  END

  SAY ''
  SAY '**** TSO Users - Owner ****'
  DO i = 1 TO tsoUsers.0
    SAY tsoUsers.i '-' tsoUsersOwners.i
  END

  SAY ''
  SAY '**** OMVS Users - Owner ****'
  DO i = 1 TO omvs.0
    SAY omvs.i '-' omvsUsers.i
  END

  SAY ''
  SAY '**** Jobs - Owner ****'
  DO i = 1 TO jobs.0
    SAY jobs.i '-' jobsUsers.i
  END
RETURN

/*------------------------------------------------------------------*/
/* Check curated SAF resource authorizations                        */
/*------------------------------------------------------------------*/
EnumAuth: PROCEDURE EXPOSE (findingsVars)
  PARSE UPPER ARG options
  CALL PrintSectionBanner 'SAF Resource Authorization'
  PARSE SOURCE . . . . . . . authEnvironment .
  IF authEnvironment == 'OMVS' THEN DO
    SAY 'The configured ACCESS load module requires a TSO environment.'
    RETURN
  END

  showAll = 0
  target = ''
  DO i = 1 TO WORDS(options)
    option = WORD(options, i)
    IF option == 'ALL' THEN showAll = 1
    ELSE target = option
  END
  IF target == '' THEN target = USERID()

  SAY 'Uses RACROUTE STATUS=ACCESS; no command or write is performed.'
  SAY 'Target user for SURROGAT/JESJOBS checks:' target
  SAY ''
  SAY 'CLASS    | ACCESS  | RESULT      | RESOURCE'
  SAY '---------|---------|-------------|' || COPIES('-', 34)

  count = 0
  CALL AddAuthSpec 'FACILITY', 'READ', 'BPX.SUPERUSER'
  CALL AddAuthSpec 'FACILITY', 'READ', 'BPX.DAEMON'
  CALL AddAuthSpec 'FACILITY', 'READ', 'BPX.SERVER'
  CALL AddAuthSpec 'FACILITY', 'READ', 'BPX.FILEATTR.APF'
  CALL AddAuthSpec 'FACILITY', 'READ', 'BPX.FILEATTR.PROGCTL'
  CALL AddAuthSpec 'FACILITY', 'READ', 'BPX.FILEATTR.SHARELIB'
  CALL AddAuthSpec 'UNIXPRIV', 'READ', 'SUPERUSER.FILESYS.CHOWN'
  CALL AddAuthSpec 'UNIXPRIV', 'READ', 'SUPERUSER.FILESYS.DIRSRCH'
  CALL AddAuthSpec 'UNIXPRIV', 'READ', 'SUPERUSER.FILESYS.MOUNT'
  CALL AddAuthSpec 'UNIXPRIV', 'UPDATE', 'SUPERUSER.FILESYS.MOUNT'
  CALL AddAuthSpec 'UNIXPRIV', 'READ', 'SUPERUSER.PROCESS.KILL'
  CALL AddAuthSpec 'UNIXPRIV', 'READ', 'SUPERUSER.PROCESS.GETPSENT'
  CALL AddAuthSpec 'UNIXPRIV', 'READ', 'SUPERUSER.SETPRIORITY'
  CALL AddAuthSpec 'UNIXPRIV', 'READ', 'SHARED.IDS'
  CALL AddAuthSpec 'TSOAUTH', 'READ', 'CONSOLE'
  CALL AddAuthSpec 'TSOAUTH', 'READ', 'CONOPER'
  CALL AddAuthSpec 'TSOAUTH', 'READ', 'OPER'
  CALL AddAuthSpec 'TSOAUTH', 'READ', 'MOUNT'
  CALL AddAuthSpec 'TSOAUTH', 'READ', 'JCL'
  CALL AddAuthSpec 'TSOAUTH', 'READ', 'ACCT'
  CALL AddAuthSpec 'TSOAUTH', 'READ', 'TESTAUTH'
  CALL AddAuthSpec 'TSOAUTH', 'UPDATE', 'PARMLIB'
  CALL AddAuthSpec 'OPERCMDS', 'READ', 'MVS.DISPLAY.JOB'
  CALL AddAuthSpec 'OPERCMDS', 'READ', 'MVS.DISPLAY.PROG'
  CALL AddAuthSpec 'OPERCMDS', 'READ', 'MVS.DISPLAY.U'
  CALL AddAuthSpec 'OPERCMDS', 'READ', 'MVS.DISPLAY.IPLINFO'
  CALL AddAuthSpec 'OPERCMDS', 'READ', 'MVS.MCSOPER.'USERID()
  CALL AddAuthSpec 'OPERCMDS', 'ALTER', 'MVS.SETPROG.LNKLST'
  CALL AddAuthSpec 'OPERCMDS', 'ALTER', 'MVS.SETPROG.APF'
  CALL AddAuthSpec 'OPERCMDS', 'ALTER', 'MVS.START.STC'
  CALL AddAuthSpec 'SURROGAT', 'READ', target'.SUBMIT'
  CALL AddAuthSpec 'SURROGAT', 'READ', 'BPX.SRV.'target

  node = SYSVAR('SYSNODE')
  IF node == '' THEN node = MVSVAR('SYSNAME')
  resource = 'SUBMIT.'node'.ENUMTEST.'target
  CALL AddAuthSpec 'JESJOBS', 'READ', resource
  resource = 'CANCEL.'node'.'target'.ENUMTEST'
  CALL AddAuthSpec 'JESJOBS', 'ALTER', resource

  shown = 0
  grantedResults = ''
  DO i = 1 TO count
    result = CheckResourceAccess(authClass.i, authAccess.i,
      authResource.i)
    IF result == 'GRANTED' THEN
      grantedResults = grantedResults || authClass.i authAccess.i,
        authResource.i || '/n'
    IF showAll | result == 'GRANTED' THEN DO
      SAY LEFT(authClass.i, 8) '|' LEFT(authAccess.i, 7) '|',
        LEFT(result, 11) '|' authResource.i
      shown = shown + 1
    END
  END
  IF shown == 0 THEN SAY 'No granted authorizations were found.'
  IF assessMode == 1 & grantedResults \== '' THEN DO
    CALL AddFinding 'SAF-SENSITIVE-AUTHORIZATIONS'
    CALL AddVerificationCaption 'Run ENUM in ASSESS mode and observe',
      'that the testing account has these sensitive SAF authorizations:'
    CALL AddVerificationContent grantedResults
  END
RETURN

/* Add one resource to the local EnumAuth inventory. */
AddAuthSpec:
  PARSE ARG authClassValue, authAccessValue, authResourceValue
  count = count + 1
  authClass.count = authClassValue
  authAccess.count = authAccessValue
  authResource.count = authResourceValue
RETURN

/* Invoke the generic mode of the configured SAF helper. */
CheckResourceAccess: PROCEDURE EXPOSE accessProgram accessProgramState
  PARSE UPPER ARG resourceClass, requestedAccess, resource

  IF STRIP(accessProgram) == '' THEN RETURN 'UNAVAILABLE'
  IF accessProgramState == 'UNAVAILABLE' THEN RETURN 'UNAVAILABLE'
  program = STRIP(accessProgram, 'B', "'")
  IF accessProgramState == 'UNKNOWN' THEN DO
    programStatus = SYSDSN("'"program"'")
    IF programStatus \== 'OK' THEN DO
      accessProgramState = 'UNAVAILABLE'
      RETURN 'UNAVAILABLE'
    END
    accessProgramState = 'READY'
  END

  parm = 'RESOURCE' resourceClass requestedAccess resource
  ADDRESS 'TSO'
  trapRc = OUTTRAP('accessOut.')
  "CALL '"program"' '"parm"'"
  callRc = RC
  trapRc = OUTTRAP('OFF')

  SELECT
    WHEN requestedAccess == 'READ' THEN required = 4
    WHEN requestedAccess == 'UPDATE' THEN required = 8
    WHEN requestedAccess == 'CONTROL' THEN required = 12
    WHEN requestedAccess == 'ALTER' THEN required = 16
    OTHERWISE RETURN 'ERROR'
  END
  IF callRc == 20 THEN RETURN 'NO DECISION'
  IF callRc == 64 | callRc < 0 THEN RETURN 'ERROR'
  IF callRc == 0 | callRc == 4 | callRc == 8 |,
     callRc == 12 | callRc == 16 THEN DO
    IF callRc >= required THEN RETURN 'GRANTED'
    RETURN 'DENIED'
  END

RETURN 'ERROR'

/*------------------------------------------------------------------*/
/* Enumerate security manager (RACF/ACF2/Top Secret)               */
/*------------------------------------------------------------------*/
EnumSecurity: PROCEDURE EXPOSE (findingsVars)

  CALL PrintSectionBanner 'Security Settings'

  IF assessMode == 0 THEN SAY 'External Security Manager:'
  ELSE SAY 'External Security Manager:'

  cvt = GetPtr(16)
  cvtrac = GetPtr(cvt+992)
  id = GetStorage(cvtrac, 4)

  SELECT
    WHEN id == 'RCVT' THEN CALL EnumRacf cvtrac
    WHEN id == 'RTSS' THEN CALL EnumTopSecret cvtrac
    OTHERWISE CALL EnumAcf2 cvt
  END
RETURN

/*------------------------------------------------------------------*/
/* Enumerate RACF configuration                                     */
/*------------------------------------------------------------------*/
EnumRacf: PROCEDURE EXPOSE (findingsVars) warningDatasets,
  excessiveUaccDatasets excessiveAccessDatasets
  PARSE ARG rcvt

  racfVrm = GetStorage(rcvt+616, 4)
  rcvtDsdt = GetPtr(rcvt+224)
  dsdtNum = GetPtr(rcvtDsdt+4)
  dsdtPrim = STRIP(GetStorage(rcvtDsdt+177, 44), 'T')
  dsdtBack = STRIP(GetStorage(rcvtDsdt+353, 44), 'T')

  SAY 'Product: RACF'
  SAY 'Version: FMID HRF'racfVrm
  SAY 'Datasets:'
  SAY ''

  excessiveAccessDatasets = ''
  SAY 'ACCESS      | DATASET'
  SAY '------------|' || COPIES('-', 44)

  IF dsdtNum == 1 THEN DO
    /* Check primary and backup; READ access is a finding */
    /* Pass empty strings for volume/missing to get simple format */
    outputprim = CheckAndReportDatasetAccess(dsdtPrim, '', '', 1)
    SAY outputprim
    outputback = CheckAndReportDatasetAccess(dsdtBack, '', '', 1)
    SAY outputback
  END
  ELSE DO
    offset = 0
    DO i = 1 TO dsdtNum
      prim = STRIP(GetStorage(rcvtDsdt+177+offset, 44), 'T')
      back = STRIP(GetStorage(rcvtDsdt+353+offset, 44), 'T')
      offset = offset + 352
      /* Check primary and backup; READ access is a finding */
      /* Pass empty strings for volume/missing to get simple format */
      outputprim = CheckAndReportDatasetAccess(prim, '', '', 1)
      SAY outputprim
      outputback = CheckAndReportDatasetAccess(back, '', '', 1)
      SAY outputback
    END
  END

  IF assessMode == 1 & excessiveAccessDatasets \== '' THEN DO
    CALL AddFinding 'RACF-DATASET-ACCESS'
    CALL AddVerificationCaption 'Run ENUM with SEC and observe that',
      'the testing account has READ or greater effective access to',
      'the RACF database datasets.'
    CALL AddVerificationContent excessiveAccessDatasets
  END

  SAY ''
  CALL EnumSetropts rcvt
RETURN

/*------------------------------------------------------------------*/
/* Enumerate Top Secret configuration                              */
/*------------------------------------------------------------------*/
EnumTopSecret: PROCEDURE EXPOSE (findingsVars) warningDatasets,
  excessiveUaccDatasets excessiveAccessDatasets
  PARSE ARG cvtrac

  rcvtDsn = STRIP(GetStorage(cvtrac+56, 44))
  SAY 'Product: Top Secret'
  SAY 'ACCESS      | DATASET'
  SAY '------------|' || COPIES('-', 44)
  access = CheckDatasetAccess(rcvtDsn, '')
  SAY LEFT(access, 11) '|' rcvtDsn
  IF assessMode == 1 & AccessAtLeastRead(access) THEN DO
    CALL AddFinding 'TSS-DATABASE-ACCESS'
    CALL AddVerificationCaption 'Run ENUM with SEC and observe that',
      'the testing account can access the Top Secret database.'
    CALL AddVerificationContent access rcvtDsn
  END
RETURN

/*------------------------------------------------------------------*/
/* Enumerate ACF2 configuration                                     */
/*------------------------------------------------------------------*/
EnumAcf2: PROCEDURE EXPOSE (findingsVars) warningDatasets,
  excessiveUaccDatasets excessiveAccessDatasets
  PARSE ARG cvt

  cvtJesct = GetPtr(cvt+296)
  sscvt = GetPtr(cvtJesct+24)

  DO WHILE sscvt <> 0
    ssctsNam = GetStorage(sscvt+8, 4)

    IF ssctsNam == 'ACF2' THEN DO
      accvt = GetPtr(sscvt+20)
      accpfxp = GetPtr(accvt-4)
      accpidl = C2D(GetStorage(accpfxp+8, 2))
      lenId = accpidl - 4
      accpids = STRIP(GetStorage(accpfxp+12, lenId))
      acf2Dsns = GetPtr(accvt+252)
      acf2Dnum = C2D(GetStorage(acf2Dsns+16, 2))

      SAY 'Product: ACF2'
      SAY 'Version:' accpids
      SAY 'Dataset(s):'
      SAY 'TYPE     | ACCESS      | DATASET'
      SAY '---------|-------------|' || COPIES('-', 44)
      accessible = ''

      DO i = 1 TO acf2Dnum
        adsOff = acf2Dsns + 24 + ((i-1)*64)
        acf2Type = STRIP(GetStorage(adsOff, 8))
        acf2Dsn = STRIP(GetStorage(adsOff+16, 44))
        access = CheckDatasetAccess(acf2Dsn, '')
        SAY LEFT(acf2Type, 8) '|' LEFT(access, 11) '|' acf2Dsn
        IF AccessAtLeastRead(access) THEN
          accessible = accessible access acf2Dsn
      END

      IF assessMode == 1 & accessible \== '' THEN DO
        CALL AddFinding 'ACF2-DATABASE-ACCESS'
        CALL AddVerificationCaption 'Run ENUM SEC and observe that',
          'the testing account can access an ACF2 database dataset.'
        CALL AddVerificationContent accessible
      END

      LEAVE
    END

    sscvt = GetPtr(sscvt+4)
  END
RETURN

/*------------------------------------------------------------------*/
/* Enumerate APF authorized libraries                              */
/*------------------------------------------------------------------*/
EnumApf: PROCEDURE EXPOSE space accessProgram accessProgramState,
  (findingsVars)

  CALL PrintSectionBanner 'APF Authorized Datasets/Libraries'

  IF space == 'OMVS' THEN DO
    SAY '! APF Dataset Checking Not Supported in UNIX'
    missing = '******'
    SAY ''
  END

  cvt = GetPtr(16)
  showAccess = STRIP(accessProgram) \== ''

  /* Initialize finding tracking arrays */
  warningDatasets = ''
  excessiveUaccDatasets = ''
  excessiveAccessDatasets = ''

  IF showAccess THEN DO
    SAY 'VOLUME | EXISTS | ACCESS      | DATASET'
    SAY '-------|--------|-------------|' || COPIES('-', 32)
  END
  ELSE DO
    SAY 'VOLUME | EXISTS | DATASET'
    SAY '-------|--------|' || COPIES('-', 44)
  END

  cvtAuthl = GetPtr(cvt+484)

  /* Check if APF table is dynamic or static */
  IF cvtAuthl == C2D('7FFFF001'x) THEN DO
    CALL EnumDynamicApf cvt, showAccess
  END
  ELSE DO
    CALL EnumStaticApf cvtAuthl, showAccess
  END

  /* Add findings for effective UPDATE+ or unprotected datasets. */
  IF showAccess & assessMode == 1 THEN DO
    IF excessiveAccessDatasets \== '' THEN DO
      CALL AddFinding 'APF-EXCESSIVE-USER-ACCESS'
      CALL AddVerificationCaption 'Run ENUM and observe',
        'UPDATE, CONTROL, ALTER, or UNPROTECTED access for these',
        'APF datasets:'
      CALL AddVerificationContent excessiveAccessDatasets
    END
  END
RETURN

/*------------------------------------------------------------------*/
/* Enumerate dynamic APF table                                      */
/*------------------------------------------------------------------*/
EnumDynamicApf: PROCEDURE EXPOSE space accessProgram accessProgramState,
  warningDatasets excessiveUaccDatasets excessiveAccessDatasets
  PARSE ARG cvt, showAccess

  cvtEcvt = GetPtr(cvt+140)
  ecvtCsvt = GetPtr(cvtEcvt+228)
  apfPtr = GetPtr(ecvtCsvt+12)
  cur = GetPtr(apfPtr+8)
  last = GetPtr(apfPtr+12)

  DO FOREVER
    dataset = GetStorage(cur+24, 44)
    missing = '  Yes '
    retcode = 0
    IF space == 'OMVS' THEN missing = '  N/A '

    IF SUBSTR(dataset, 1, 1) \== '00'x THEN DO
      volSms = GetStorage(cur+4, 1)

      IF BITAND(volSms, '80'x) == '80'x THEN DO
        volume = 'SMS   '
        IF space /== 'OMVS' THEN
          retcode = LISTDSI("'"STRIP(dataset)"'" norecall)
      END
      ELSE DO
        volume = GetStorage(cur+68, 6)
        IF space /== 'OMVS' THEN
          retcode = LISTDSI("'"STRIP(dataset)"'",
            'volume('STRIP(volume)')' norecall)
      END

      IF retcode <> 0 THEN DO
        IF SYSREASON == 24 THEN missing = '  No  '
        ELSE missing = SPACE(D2C(SYSREASON), 8, ' ')
      END

      /* Check dataset access if on RACF */
      IF showAccess THEN DO
        output = CheckAndReportDatasetAccess(dataset, volume, missing)
        SAY output
      END
      ELSE DO
        SAY LEFT(STRIP(volume),6) '|' STRIP(LEFT(missing,6)),
           '|' STRIP(dataset)
      END
    END

    IF cur == last THEN LEAVE
    cur = GetPtr(cur+8)
  END
RETURN

/*------------------------------------------------------------------*/
/* Enumerate static APF table                                       */
/*------------------------------------------------------------------*/
EnumStaticApf: PROCEDURE EXPOSE accessProgram accessProgramState,
  warningDatasets excessiveUaccDatasets excessiveAccessDatasets
  PARSE ARG cvtAuthl, showAccess

  numApf = C2D(GetStorage(cvtAuthl, 2))
  len = C2D(GetStorage(cvtAuthl+2, 1))
  cur = cvtAuthl + 3

  DO i = 1 TO numApf
    volume = GetStorage(cur, 6)
    dataset = GetStorage(cur+7, len)
    missing = '  N/A  '

    /* Check dataset access if on RACF */
    IF showAccess THEN DO
      output = CheckAndReportDatasetAccess(dataset, volume, missing)
      SAY output
    END
    ELSE DO
      SAY STRIP(volume) '|' STRIP(dataset)
    END

    cur = cur + len + 1
    len = C2D(GetStorage(cur-1, 1))
  END
RETURN

/*------------------------------------------------------------------*/
/* Enumerate operating system version information                  */
/*------------------------------------------------------------------*/
EnumVersion: PROCEDURE

  CALL PrintSectionBanner 'Operating System Version'

  cvt = GetPtr(16)
  cvtExt2 = GetPtr(cvt+328)
  cvtJesct = GetPtr(cvt+296)
  ecvt = GetPtr(cvt+140)

  /* OS version */
  prodName = GetStorage(cvt-40, 7)
  prodName2 = STRIP(GetStorage(ecvt+496, 16), 'T')
  ver = GetStorage(ecvt+512, 2)
  rel = GetStorage(ecvt+514, 2)
  mod = GetStorage(ecvt+516, 2)
  vrm = ver'.'rel'.'mod
  fmidNum = GetStorage(cvt-32, 7)

  SAY 'The OS version is' prodName2 vrm '- FMID' fmidNum,
    '('prodName').'

  /* LPAR and Processor information */
  csd = GetPtr(cvt+660)
  ecvtHdnm = GetStorage(ecvt+336, 8)  /* Hardware name */
  ecvtLpnm = GetStorage(ecvt+344, 8)  /* LPAR name */

  IF ecvtHdnm \== '        ' & ecvtLpnm \== '        ' THEN DO
    csdPlpn = C2D(GetStorage(csd+252, 1))  /* LPAR number */
    SAY 'The Processor name is' STRIP(ecvtHdnm)'.',
      'The LPAR SMFID is' STRIP(ecvtLpnm) '(LPAR #'csdPlpn').'
  END

  /* TSO version */
  cvtTvt = GetPtr(cvt+156)
  tsvtLver = GetStorage(cvtTvt+100, 1)
  tsvtLrel = GetStorage(cvtTvt+101, 2)
  tsvtLrel = FORMAT(tsvtLrel)
  tsvtLmod = GetStorage(cvtTvt+103, 1)
  tsoLev = tsvtLver'.'tsvtLrel'.'tsvtLmod
  SAY 'TSO:' tsoLev

  /* JES version */
  CALL EnumJes cvtJesct

  /* VTAM version */
  CALL EnumVtam cvtExt2
RETURN

/*------------------------------------------------------------------*/
/* Enumerate JES information                                        */
/*------------------------------------------------------------------*/
EnumJes: PROCEDURE EXPOSE space
  PARSE ARG cvtJesct

  jesSsct = GetPtr(cvtJesct+24)
  jesPjesn = GetStorage(cvtJesct+28, 4)
  ssctsNam = GetStorage(jesSsct+8, 4)

  DO UNTIL jesSsct == 0
    IF jesPjesn == ssctsNam THEN DO
      ssctSsvt = GetPtr(jesSsct+16)
      ssctSuse = GetPtr(jesSsct+20)
      ssctSus2 = GetPtr(jesSsct+28)
      LEAVE
    END
    jesSsct = GetPtr(jesSsct+4)
  END

  IF jesPjesn == 'JES3' THEN DO
    IF space == 'OMVS' THEN DO
      jesVers = 'JES3'
      jesNode = MVSVAR('SYSNAME')
    END
    ELSE DO
      jesVers = SYSVAR('SYSJES')
      jesNode = SYSVAR('SYSNODE')
    END
  END
  ELSE IF jesPjesn == 'JES2' THEN DO
    jesVers = STRIP(GetStorage(ssctSuse, 8))
    jesNode = GetJes2Node(jesVers, ssctSus2)
  END

  SAY 'JES:' jesPjesn jesVers 'Node:' jesNode
RETURN

/*------------------------------------------------------------------*/
/* Get JES2 node name based on version                             */
/*------------------------------------------------------------------*/
GetJes2Node: PROCEDURE
  PARSE ARG jesVers, ssctSus2

  prefix = SUBSTR(jesVers, 1, 8)

  SELECT
    WHEN prefix == 'z/OS 2.2' THEN
      jesNode = STRIP(GetStorage(ssctSus2+664, 8))
    WHEN prefix == 'z/OS 2.1' | prefix == 'z/OS1.13' |,
         prefix == 'z/OS1.12' | prefix == 'z/OS1.11' THEN
      jesNode = STRIP(GetStorage(ssctSus2+656, 8))
    WHEN prefix == 'z/OS1.10' | prefix == 'z/OS 1.9' THEN
      jesNode = STRIP(GetStorage(ssctSus2+708, 8))
    WHEN prefix == 'z/OS 1.8' THEN
      jesNode = STRIP(GetStorage(ssctSus2+620, 8))
    WHEN prefix == 'z/OS 1.7' THEN
      jesNode = STRIP(GetStorage(ssctSus2+616, 8))
    WHEN prefix == 'z/OS 1.5' | prefix == 'z/OS 1.4' THEN
      jesNode = STRIP(GetStorage(ssctSus2+532, 8))
    WHEN SUBSTR(jesVers,1,7) == 'OS 2.10' |,
         prefix == 'z/OS 1.2' THEN
      jesNode = STRIP(GetStorage(ssctSus2+452, 8))
    WHEN SUBSTR(jesVers,1,6) == 'OS 1.1' |,
         SUBSTR(jesVers,1,4) == 'SP 5' THEN
      jesNode = STRIP(GetStorage(ssctSus2+336, 8))
    WHEN SUBSTR(jesVers,1,5) == 'OS 1.' |,
         SUBSTR(jesVers,1,5) == 'OS 2.' THEN
      jesNode = STRIP(GetStorage(ssctSus2+372, 8))
    OTHERWISE
      jesNode = MVSVAR('SYSNAME')
  END

RETURN jesNode

/*------------------------------------------------------------------*/
/* Enumerate VTAM information                                       */
/*------------------------------------------------------------------*/
EnumVtam: PROCEDURE
  PARSE ARG cvtExt2

  chkVtAct = GetStorage(cvtExt2+64, 1)

  IF BITAND(chkVtAct, '80'x) == '80'x THEN DO
    cvtAtcvt = C2D(GetStorage(cvtExt2+65, 3))
    istAtcvt = GetPtr(cvtAtcvt)
    atcvtLvl = GetStorage(istAtcvt, 8)
    vtamVer = SUBSTR(atcvtLvl, 3, 1)
    vtamRel = SUBSTR(atcvtLvl, 4, 1)
    vtamMod = SUBSTR(atcvtLvl, 5, 1)

    IF vtamMod == ' ' THEN vtamLev = vtamVer'.'vtamRel
    ELSE vtamLev = vtamVer'.'vtamRel'.'vtamMod

    atcNetid = STRIP(GetStorage(istAtcvt+2080, 8))
    atcNqnam = STRIP(GetStorage(istAtcvt+2412, 17))

    SAY 'VTAM:' vtamLev '(NETID:' atcNetid')',
      '(SSCPNAME:' atcNqnam')'
  END
