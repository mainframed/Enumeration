/*------------------------------------------------------------------*/
/* Enumerate SVC table                                              */
/*------------------------------------------------------------------*/
EnumSvc: PROCEDURE EXPOSE (findingsVars)

  CALL PrintSectionBanner 'SVC Table'
  IF assessMode == 0 THEN DO
    SAY 'Installed SVCs (APF authorized only):'
  END
  ELSE DO
    SAY 'Installed SVCs:'
  END
  SAY 'SVCEP    | SVC | HX | TYPE | APF | ESR'
  SAY '---------|-----|----|------|-----|----'

  cvt = GetPtr(16)
  cvtAbend = GetPtr(cvt+200)
  scvtSvct = GetPtr(cvtAbend+132)
  cvtNucmp = GetPtr(cvt+1200)
  nucmAddr = GetPtr(cvtNucmp+8)

  /* Find IGCERROR address */
  nucmap = cvtNucmp + 16
  DO WHILE nucmap <= nucmAddr
    IF GetStorage(nucmap, 8) == 'IGCERROR' THEN DO
      igcError = GetStorage(nucmap+8, 4)
      LEAVE
    END
    nucmap = nucmap + 16
  END

  /* Iterate through SVC table */
  DO i = 0 TO 255
    addr = BITAND(GetStorage(scvtSvct+(i*8), 4), '7FFFFFFF'x)

    IF igcError \== addr THEN DO
      svcType = GetStorage(scvtSvct+(i*8)+4, 1)

      /* Determine type */
      SELECT
        WHEN BITAND(svcType, '80'x) == '80'x THEN type = '2'
        WHEN BITAND(svcType, 'C0'x) == 'C0'x THEN type = '3/4'
        WHEN BITAND(svcType, '20'x) == '20'x THEN type = '6'
        WHEN BITAND(svcType, 'F0'x) == '00'x THEN type = '1'
        OTHERWISE type = '?'
      END

      /* Check APF and ESR flags */
      IF BITAND(svcType, '08'x) == '08'x THEN apf = 'Y'
      ELSE apf = 'N'

      IF BITAND(svcType, '04'x) == '04'x THEN esr = 'Y'
      ELSE esr = 'N'

      /* If not in assess mode, only show APF authorized SVCs */
      IF assessMode == 0 THEN DO
        IF apf == 'Y' THEN DO
          SAY C2X(GetStorage(scvtSvct+(i*8), 4)) '|',
            RIGHT(i, 3, 0) '|' RIGHT(D2X(i), 2, 0) '|',
            type '  |' apf '|' esr
        END
      END
      ELSE DO
        /* In assess mode, show all SVCs */
        SAY C2X(GetStorage(scvtSvct+(i*8), 4)) '|',
          RIGHT(i, 3, 0) '|' RIGHT(D2X(i), 2, 0) '|',
          type '  |' apf '|' esr
      END
    END
  END
RETURN

/*------------------------------------------------------------------*/
/* Enumerate PARMLIB plus library DD concatenations                 */
/*------------------------------------------------------------------*/
EnumLibraries: PROCEDURE EXPOSE accessProgram accessProgramState,
  (findingsVars)
  PARSE ARG detail

  CALL EnumParmlib
  IF detail >= 1 THEN
    CALL EnumTiotLibraries 'ALL', 1
  ELSE
    CALL EnumTiotLibraries 'LIBS', 0
RETURN

/*------------------------------------------------------------------*/
/* Enumerate the logical PARMLIB list from the IPA                  */
/* Based on Mark Zelden's IPLINFO mapping                           */
/*------------------------------------------------------------------*/
EnumParmlib: PROCEDURE EXPOSE accessProgram accessProgramState,
  (findingsVars)
  CALL PrintSectionBanner 'Logical PARMLIB Concatenation'

  cvt = GetPtr(16)
  IF cvt == 0 THEN DO
    SAY 'PARMLIB unavailable: CVT pointer is zero.'
    RETURN
  END

  ecvt = GetPtr(cvt+140)
  IF ecvt == 0 THEN DO
    SAY 'PARMLIB unavailable: ECVT pointer is zero.'
    RETURN
  END

  ipa = GetPtr(ecvt+392)
  IF ipa == 0 THEN DO
    SAY 'PARMLIB unavailable: IPA pointer is zero.'
    RETURN
  END

  cvtOslv2 = GetStorage(cvt+1266, 1)
  IF BITAND(cvtOslv2, '01'x) == '01'x THEN
    count = C2D(GetStorage(ipa+2134, 2))
  ELSE
    count = C2D(GetStorage(ipa+2148, 2))

  IF count < 1 | count > 16 THEN DO
    SAY 'PARMLIB unavailable: implausible IPA entry count' count'.'
    RETURN
  END

  SAY 'ORDER | VOLUME | ACCESS      | DATASET Name'
  SAY '------|--------|-------------|' || COPIES('-', 31)
  offset = 0
  shown = 0
  risky = ''
  DO i = 1 TO count
    card = GetStorage(ipa+416+offset, 63)
    flag = GetStorage(ipa+479+offset, 1)
    dataset = STRIP(SUBSTR(card, 1, 44), 'T')
    volume = STRIP(SUBSTR(card, 46, 6))

    IF BITAND(flag, '20'x) == '20'x THEN volume = '*CATLG'
    IF volume == '' THEN volume = '-'
    IF dataset \== '' THEN DO
      access = CheckDatasetAccess(dataset, volume)
      SAY RIGHT(i, 5) '|' LEFT(volume, 6) '|',
        LEFT(access, 11) '|' dataset
      IF access == 'UPDATE' | access == 'CONTROL' |,
         access == 'ALTER' | access == 'UNPROTECTED' THEN
        risky = risky dataset
      shown = shown + 1
    END
    offset = offset + 64
  END

  IF shown == 0 THEN
    SAY 'No PARMLIB dataset names were present in the IPA.'
  SAY ''
  SAY 'IPA memory view; verify sites that changed PARMLIB with SETLOAD.'
  IF assessMode == 1 & risky \== '' THEN DO
    CALL AddFinding 'PARMLIB-EXCESSIVE-USER-ACCESS'
    CALL AddVerificationCaption 'Run ENUM with LIBS and observe that',
      'the testing account can modify a PARMLIB dataset.'
    CALL AddVerificationContent risky
  END
RETURN

/*------------------------------------------------------------------*/
/* Enumerate dataset concatenations (PATH)                          */
/*------------------------------------------------------------------*/
EnumPath: PROCEDURE EXPOSE accessProgram accessProgramState
  PARSE ARG lvl
  CALL EnumTiotLibraries 'PATH', lvl
RETURN

/*------------------------------------------------------------------*/
/* Walk current address-space TIOT library allocations              */
/*------------------------------------------------------------------*/
EnumTiotLibraries: PROCEDURE EXPOSE accessProgram accessProgramState
  PARSE UPPER ARG mode, lvl

  IF lvl < 1 THEN lvl = 0
  IF mode == 'LIBS' THEN DO
    CALL PrintSectionBanner 'Current Address-Space Library DDs'
    SAY 'PARMLIB is system-wide; rows below are current TIOT only.'
    SAY 'JES2 dynamic and other address-space PROCLIBs are not shown.'
  END
  ELSE
    CALL PrintSectionBanner 'DDNAME Concatenations'

  IF mode == 'PATH' & lvl < 1 THEN DO
    SAY 'Only displaying SYSPROC/SYSEXEC'
    SAY ''
    SAY 'DD       | ACCESS      | DATASET Name'
    SAY '---------|-------------|' || COPIES('-', 31)
  END
  ELSE DO
    SAY ''
    SAY 'DD       | VOLUME | ACCESS      | DATASET Name'
    SAY '---------|--------|-------------|' || COPIES('-', 22)
  END

  tcb = C2D(STORAGE('21C', 4))
  IF tcb == 0 THEN DO
    SAY 'TIOT unavailable: current TCB pointer is zero.'
    RETURN
  END
  tcbTio = GetPtr(tcb+12)
  IF tcbTio == 0 THEN DO
    SAY 'TIOT unavailable: current TIOT pointer is zero.'
    RETURN
  END

  tiot = tcbTio + 24
  tioElngh = 0
  dd = ''
  entries = 0
  shown = 0
  seen = '|'

  DO WHILE entries < 4096
    tiot = tiot + tioElngh
    tioElngh = C2D(GetStorage(tiot, 1))
    IF tioElngh == 0 THEN LEAVE
    IF tioElngh < 16 THEN DO
      SAY 'TIOT walk stopped: implausible entry length' tioElngh'.'
      LEAVE
    END
    entries = entries + 1

    tioEddnm = GetStorage(tiot+4, 8)
    IF tioEddnm \== '        ' THEN dd = STRIP(tioEddnm)
    token = GetStorage(tiot+12, 3)
    IF C2X(token) == '000000' THEN ITERATE

    dsnAddr = Swareq(token)
    IF dsnAddr <= 0 THEN ITERATE
    dataset = STRIP(GetStorage(dsnAddr, 44))
    volume = STRIP(GetStorage(dsnAddr+118, 6))
    IF dataset == '' THEN ITERATE
    IF volume == '' THEN volume = '-'

    show = 0
    IF mode == 'ALL' | lvl >= 1 THEN show = 1
    ELSE IF dd == 'SYSPROC' | dd == 'SYSEXEC' THEN show = 1
    ELSE IF mode == 'LIBS' THEN DO
      IF dd == 'IEFPDSI' | dd == 'IEFJOBS' THEN show = 1
      ELSE IF LEFT(dd, 4) == 'PROC' THEN show = 1
    END

    key = dd'/'volume'/'dataset
    IF show == 1 & POS('|'key'|', seen) == 0 THEN DO
      access = CheckDatasetAccess(dataset, volume)
      IF mode == 'PATH' & lvl < 1 THEN
        SAY LEFT(dd, 8) '|' LEFT(access, 11) '|' dataset
      ELSE
        SAY LEFT(dd, 8) '|' LEFT(volume, 6) '|',
          LEFT(access, 11) '|' dataset
      seen = seen || key || '|'
      shown = shown + 1
    END
  END

  IF entries >= 4096 THEN
    SAY 'TIOT walk stopped at the 4096-entry safety limit.'
  IF shown == 0 THEN
    SAY 'No requested library DD datasets are allocated here.'
RETURN

/*------------------------------------------------------------------*/
/* Enumerate LPA library datasets                                   */
/*------------------------------------------------------------------*/
EnumLpa: PROCEDURE EXPOSE accessProgram accessProgramState,
  (findingsVars)
  CALL PrintSectionBanner 'LPA Library Datasets'

  cvt = GetPtr(16)
  smext = GetPtr(cvt+1196)
  IF smext == 0 THEN DO
    SAY 'LPA list unavailable: storage-map extension is absent.'
    RETURN
  END
  lpa = GetPtr(smext+56)
  IF lpa == 0 THEN DO
    SAY 'LPA list unavailable: ELPA table pointer is zero.'
    RETURN
  END
  count = GetPtr(lpa+4)
  IF count < 1 | count > 4096 THEN DO
    SAY 'LPA list unavailable: implausible entry count' count'.'
    RETURN
  END

  SAY 'ORDER | ACCESS      | DATASET Name'
  SAY '------|-------------|' || COPIES('-', 38)
  offset = 8
  risky = ''
  DO i = 1 TO count
    len = C2D(GetStorage(lpa+offset, 1))
    IF len < 1 | len > 44 THEN DO
      SAY 'LPA walk stopped: implausible dataset length' len'.'
      LEAVE
    END
    dataset = STRIP(GetStorage(lpa+offset+1, len))
    access = CheckDatasetAccess(dataset, '')
    SAY RIGHT(i, 5) '|' LEFT(access, 11) '|' dataset
    IF access == 'UPDATE' | access == 'CONTROL' | access == 'ALTER' |,
       access == 'UNPROTECTED' THEN risky = risky dataset
    offset = offset + 45
  END
  IF assessMode == 1 & risky \== '' THEN DO
    CALL AddFinding 'LPA-EXCESSIVE-USER-ACCESS'
    CALL AddVerificationCaption 'Run ENUM with LPA and observe that',
      'the testing account can modify an LPA library dataset.'
    CALL AddVerificationContent risky
  END
RETURN

/*------------------------------------------------------------------*/
/* Enumerate the current address-space LINKLIST set                 */
/*------------------------------------------------------------------*/
EnumLinklist: PROCEDURE EXPOSE accessProgram accessProgramState,
  (findingsVars)
  CALL PrintSectionBanner 'Current LINKLIST Set'

  cvt = GetPtr(16)
  cvtOslv1 = GetStorage(cvt+1265, 1)
  modern = BITAND(cvtOslv1, '01'x) == '01'x
  setname = 'LEGACY'
  volumeTable = 0

  IF modern THEN DO
    ascb = GetPtr(X2D('224'))
    IF ascb == 0 THEN DO
      SAY 'LINKLIST unavailable: current ASCB pointer is zero.'
      RETURN
    END
    assb = GetPtr(ascb+336)
    IF assb == 0 THEN DO
      SAY 'LINKLIST unavailable: current ASSB pointer is zero.'
      RETURN
    END
    dlcb = GetPtr(assb+236)
    IF dlcb == 0 THEN DO
      SAY 'LINKLIST unavailable: CSVDLCB pointer is zero.'
      RETURN
    END
    flags = GetStorage(dlcb+32, 1)
    setname = STRIP(GetStorage(dlcb+36, 16))
    linkTable = GetPtr(dlcb+16)
    volumeTable = GetPtr(dlcb+20)
    IF BITAND(flags, '10'x) == '10'x THEN lnkauth = 'LNKLST'
    ELSE lnkauth = 'APFTAB'
  END
  ELSE DO
    linkTable = GetPtr(cvt+1244)
    lnkauth = 'UNKNOWN'
  END

  IF linkTable == 0 THEN DO
    SAY 'LINKLIST unavailable: library table pointer is zero.'
    RETURN
  END
  count = GetPtr(linkTable+4)
  IF count < 1 | count > 4096 THEN DO
    SAY 'LINKLIST unavailable: implausible entry count' count'.'
    RETURN
  END

  SAY 'Set:' setname 'LNKAUTH='lnkauth
  SAY 'ORDER | APF | VOLUME | ACCESS      | DATASET Name'
  SAY '------|-----|--------|-------------|' || COPIES('-', 20)
  entryOffset = 8
  volumeOffset = 8
  apfTable = linkTable + 8 + (count*45)
  risky = ''
  DO i = 1 TO count
    len = C2D(GetStorage(linkTable+entryOffset, 1))
    IF len < 1 | len > 44 THEN DO
      SAY 'LINKLIST walk stopped: implausible dataset length' len'.'
      LEAVE
    END
    dataset = STRIP(GetStorage(linkTable+entryOffset+1, len))
    apfFlag = GetStorage(apfTable+i-1, 1)
    IF BITAND(apfFlag, '80'x) == '80'x THEN apf = 'Y'
    ELSE apf = '-'
    volume = '-'
    IF volumeTable \== 0 THEN
      volume = STRIP(GetStorage(volumeTable+volumeOffset, 6))
    IF volume == '' THEN volume = '-'
    access = CheckDatasetAccess(dataset, volume)
    SAY RIGHT(i, 5) '|' LEFT(apf, 3) '|' LEFT(volume, 6) '|',
      LEFT(access, 11) '|' dataset
    IF access == 'UPDATE' | access == 'CONTROL' | access == 'ALTER' |,
       access == 'UNPROTECTED' THEN risky = risky dataset
    entryOffset = entryOffset + 45
    volumeOffset = volumeOffset + 8
  END
  IF assessMode == 1 & risky \== '' THEN DO
    CALL AddFinding 'LINKLIST-EXCESSIVE-USER-ACCESS'
    CALL AddVerificationCaption 'Run ENUM with LNK and observe that',
      'the testing account can modify a LINKLIST library dataset.'
    CALL AddVerificationContent risky
  END
RETURN

/*------------------------------------------------------------------*/
/* Enumerate active SMF recording datasets                          */
/*------------------------------------------------------------------*/
EnumSmf: PROCEDURE EXPOSE accessProgram accessProgramState,
  (findingsVars)
  CALL PrintSectionBanner 'SMF Recording Datasets'

  cvt = GetPtr(16)
  smcaRaw = GetStorage(cvt+196, 4)
  smca = C2D(BITAND(smcaRaw, '7FFFFFFF'x))
  IF smca == 0 THEN DO
    SAY 'SMF information unavailable: SMCA pointer is zero.'
    RETURN
  END
  misc = GetStorage(smca+1, 1)
  IF BITAND(misc, '80'x) \== '80'x THEN DO
    SAY 'SMF recording is not active.'
    RETURN
  END

  first = GetPtr(smca+244)
  last = GetPtr(smca+248)
  smcx = GetPtr(smca+376)
  logstream = 0
  IF smcx \== 0 THEN DO
    logBits = GetStorage(smcx+88, 1)
    logstream = BITAND(logBits, '80'x) == '80'x
  END
  IF logstream THEN
    SAY 'SMF logstream is active; names unavailable.'
  IF first == 0 | last == 0 | first == last THEN DO
    SAY 'No active SMF recording datasets are available.'
    RETURN
  END

  SAY 'VOLUME | USED | STATUS         | ACCESS      | DATASET'
  SAY '-------|------|----------------|-------------|---------------'
  cur = first
  entries = 0
  risky = ''
  DO WHILE cur \== last & cur \== 0 & entries < 256
    dataset = STRIP(GetStorage(cur+16, 44))
    volume = STRIP(GetStorage(cur+60, 6))
    capacity = GetPtr(cur+76)
    nextBlock = GetPtr(cur+80)
    IF capacity > 0 THEN percent = TRUNC((nextBlock/capacity)*100)
    ELSE percent = 0
    flags = GetStorage(cur+12, 1)
    SELECT
      WHEN BITAND(flags, '10'x) == '10'x THEN status = 'FREE REQUIRED'
      WHEN BITAND(flags, '08'x) == '08'x THEN status = 'DUMP REQUIRED'
      WHEN BITAND(flags, '04'x) == '04'x THEN status = 'ALTERNATE'
      WHEN BITAND(flags, '02'x) == '02'x THEN status = 'CLOSE PENDING'
      WHEN BITAND(flags, '01'x) == '01'x THEN status = 'OPEN REQUIRED'
      OTHERWISE status = 'ACTIVE'
    END
    access = CheckDatasetAccess(dataset, volume)
    SAY LEFT(volume, 6) '|' RIGHT(percent, 4)'% |',
      LEFT(status, 14) '|' LEFT(access, 11) '|' dataset
    IF access == 'UPDATE' | access == 'CONTROL' | access == 'ALTER' |,
       access == 'UNPROTECTED' THEN risky = risky dataset
    cur = GetPtr(cur+4)
    entries = entries + 1
  END
  IF entries >= 256 THEN SAY 'SMF walk stopped at 256-entry limit.'

  IF assessMode == 1 & risky \== '' THEN DO
    CALL AddFinding 'SMF-DATASET-EXCESSIVE-USER-ACCESS'
    CALL AddVerificationCaption 'Run ENUM with SMF and observe that',
      'the testing account can modify an SMF recording dataset.'
    CALL AddVerificationContent risky
  END
RETURN

