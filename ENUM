/*------------------------------------------------------------------*/
/* Replace all occurrences of a string                              */
/*------------------------------------------------------------------*/
ReplaceStr: PROCEDURE
  PARSE ARG text, old, new

  DO WHILE POS(old, text) > 0
    p = POS(old, text)
    text = SUBSTR(text, 1, p-1) || new ||,
      SUBSTR(text, p+LENGTH(old))
  END

RETURN text

