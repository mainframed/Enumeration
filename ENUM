/*------------------------------------------------------------------*/
/* Convert SWA Virtual Address to 31-bit address                    */
/* Credit: Gilbert Saint-Flour                                      */
/*------------------------------------------------------------------*/
Swareq: PROCEDURE
  sva = C2D(ARG(1))
  IF sva == 0 THEN RETURN 0

  tcb = C2D(STORAGE('21C', 4))
  IF tcb == 0 THEN RETURN 0
  jscb = GetPtr(tcb+180)
  IF jscb == 0 THEN RETURN 0
  qmpl = GetPtr(jscb+244)
  IF qmpl == 0 THEN RETURN 0

  /* Check if QMAT can be above the bar */
  qmsta = C2X(GetStorage(qmpl+16, 1))

  IF SUBSTR(X2B(qmsta), 6, 1) THEN DO
    /* QMAT can be ATB */
    IF RIGHT(X2B(C2X(ARG(1))), 1) \== '1' THEN
      RETURN C2D(ARG(1)) + 16

    qmat = C2D(GetStorage(qmpl+10, 2)) * (2**48) +,
      C2D(GetStorage(qmpl+18, 2)) * (2**32) +,
      GetPtr(qmpl+24)

    IF qmat == 0 THEN RETURN 0
    swaAddr = GetPtr(qmat+(sva*12)+64)
    IF swaAddr == 0 THEN RETURN 0
    RETURN swaAddr + 16
  END
  ELSE DO
    /* QMAT is BTB */
    IF RIGHT(C2X(ARG(1)), 1) \== 'F' THEN
      RETURN C2D(ARG(1)) + 16

    qmat = GetPtr(qmpl+24)
    IF qmat == 0 THEN RETURN 0

    hops = 0
    DO WHILE sva > 65536 & hops < 256
      qmat = GetPtr(qmat+12)
      IF qmat == 0 THEN RETURN 0
      sva = sva - 65536
      hops = hops + 1
    END

    IF hops >= 256 THEN RETURN 0
    swaAddr = GetPtr(qmat+sva+1)
    IF swaAddr == 0 THEN RETURN 0
    RETURN swaAddr + 16
  END

