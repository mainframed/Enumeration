//ENUMJOB  JOB (ACCT),'ZOS ENUM',CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID,REGION=0M
//CLEANUP  EXEC PGM=IEFBR14
//OLDOUT   DD DSN=&SYSUID..ENUM.OUTPUT,
//            DISP=(MOD,DELETE,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(1,1))
//*
//ENUM     EXEC PGM=IKJEFT1B,DYNAMNBR=50
//SYSTSPRT DD DSN=&SYSUID..ENUM.OUTPUT,
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(5,5),RLSE),
//            DCB=(RECFM=VB,LRECL=1028,BLKSIZE=0)
//SYSTSIN  DD *
  EXEC 'YOURID.ENUM.EXEC' 'ALL' EXEC
/*
