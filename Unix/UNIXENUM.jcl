/* credit to https://16colo.rs/pack/sae-006/FMB-SKLL.ASC */
SAY "$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$"||,
"$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$"
SAY "$$$$$$$$$$$7'`         `'!$$$$$$$$$$$$$"||,
"$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$"
SAY "$$$$$$$7'                  `$$$$$$$$$  "||,
"     $     Y$$   $   $$$   $    YP    $$"
SAY "$$$$7'              $$$:.   :$$$$$$$$  "||,
" $$$$$   L  ?$   $   $$$   $   s  s   $$"
SAY "$$$'                 '7$'    `$$$$$$$  "||,
"    $$   $L  ?   $   $$$   $   $$$$   $$"
SAY "$$          .4$$$a           :$$$$$$$  "||,
" $$$$$   $$L     $   Y$P   $   $$$$   $$"
SAY "$        .4$$$$$$$    $$    .$$$$$$$$  "||,
"     $   $$$L    $L       J$   $$$$   $$"
SAY ":       :$$$$$$$$'   $$$$     ~'$$$$$$$"||,
"$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$"
SAY "!        '!:$$$7'                 '$$$$"||,
"$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$"
SAY "                                   `+$$"||,
"$$$$$$$$$P     Y$$$$$P       Y$$$$$$$$$$"
SAY ".                                    l$"||,
"$$$$$$$$$  Y$P  $$$$$   $$$   $$$$$$$$$$"
SAY "::                                .4$$$"||,
"$$$$$$$$$$$P  S$$$$$$   $$$   $$$$$$$$$$"
SAY "$$a.             .$             .4$$$$$"||,
"$$$$$$$$$P  l$$$$$$$$   Y$P   $$$$$$$$$$"
SAY "$$$$b.          $$$$b.       .4$$$$$$$$"||,
"$$$$$$$$$       $$  $L       J$$$$$$$$$$"
