//ACCRUN JOB CLASS=A,MSGCLASS=Y,NOTIFY=&SYSUID,MSGLEVEL=(1,1)
//* ACCESS returns the effective access level as its return code.
//ACCESS   EXEC PGM=IKJEFT1B,REGION=0M
//STEPLIB  DD DSN=&SYSUID..ENUM.LOADLIB,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD *,SYMBOLS=EXECSYS
 CALL '&SYSUID..ENUM.LOADLIB(ACCESS)' -
   'RESOURCE TSOAUTH READ CONSOLE'
/*
