//ENUMPACK JOB CLASS=A,MSGCLASS=Y,NOTIFY=&SYSUID,MSGLEVEL=(1,1)
//LOADLIB  EXEC PGM=IKJEFT1B,DYNAMNBR=30,COND=(0,NE)
//SYSTSPRT DD SYSOUT=*
//XMITOUT  DD DSN=&SYSUID..ENUM.XMILIB(LOADLIB),DISP=SHR,
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//SYSTSIN  DD *,SYMBOLS=EXECSYS
 XMIT LOCAL.&SYSUID DATASET('&SYSUID..ENUM.LOADLIB') -
   OUTDDNAME(XMITOUT) NONOTIFY NOLOG
/*
//JCLLIB   EXEC PGM=IKJEFT1B,DYNAMNBR=30,COND=(0,NE)
//SYSTSPRT DD SYSOUT=*
//XMITOUT  DD DSN=&SYSUID..ENUM.XMILIB(JCLLIB),DISP=SHR,
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//SYSTSIN  DD *,SYMBOLS=EXECSYS
 XMIT LOCAL.&SYSUID DATASET('&SYSUID..ENUM.JCLLIB') -
   OUTDDNAME(XMITOUT) NONOTIFY NOLOG
/*
