/*
//OUTER    EXEC PGM=IKJEFT1B,DYNAMNBR=30,COND=(0,NE)
//SYSTSPRT DD SYSOUT=*
//XMITOUT  DD DSN=&SYSUID..ENUM.XMI,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSALLDA,SPACE=(CYL,(20,5),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920)
//SYSTSIN  DD *,SYMBOLS=EXECSYS
 XMIT LOCAL.&SYSUID DATASET('&SYSUID..ENUM.XMILIB') -
   OUTDDNAME(XMITOUT) NONOTIFY NOLOG
/*
