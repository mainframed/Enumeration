PROC 0
/* Receive outer XMIT as &SYSUID..ENUM.XMILIB before running. */
CONTROL NOFLUSH PROMPT
IF &SYSDSN('&SYSUID..ENUM.LOADLIB') = OK THEN DO
  WRITE &SYSUID..ENUM.LOADLIB ALREADY EXISTS. RENAME IT FIRST.
  EXIT CODE(8)
END
IF &SYSDSN('&SYSUID..ENUM.JCLLIB') = OK THEN DO
  WRITE &SYSUID..ENUM.JCLLIB ALREADY EXISTS. RENAME IT FIRST.
  EXIT CODE(8)
END
IF &SYSDSN('&SYSUID..ENUM.SOURCE') = OK THEN DO
  WRITE &SYSUID..ENUM.SOURCE ALREADY EXISTS. RENAME IT FIRST.
  EXIT CODE(8)
END
IF &SYSDSN('&SYSUID..ENUM.REXXLIB') = OK THEN DO
  WRITE &SYSUID..ENUM.REXXLIB ALREADY EXISTS. RENAME IT FIRST.
  EXIT CODE(8)
END
IF &SYSDSN('&SYSUID..ENUM.UNIXTAR') = OK THEN DO
  WRITE &SYSUID..ENUM.UNIXTAR ALREADY EXISTS. RENAME IT FIRST.
  EXIT CODE(8)
END
SET STATUS = &SYSDSN('&SYSUID..ENUM.LOADLIB')
IF &STR(&STATUS) NE &STR(DATASET NOT FOUND) THEN DO
  WRITE CANNOT CONFIRM &SYSUID..ENUM.LOADLIB IS ABSENT: &STATUS
  EXIT CODE(12)
END
SET STATUS = &SYSDSN('&SYSUID..ENUM.JCLLIB')
IF &STR(&STATUS) NE &STR(DATASET NOT FOUND) THEN DO
  WRITE CANNOT CONFIRM &SYSUID..ENUM.JCLLIB IS ABSENT: &STATUS
  EXIT CODE(12)
END
SET STATUS = &SYSDSN('&SYSUID..ENUM.SOURCE')
IF &STR(&STATUS) NE &STR(DATASET NOT FOUND) THEN DO
  WRITE CANNOT CONFIRM &SYSUID..ENUM.SOURCE IS ABSENT: &STATUS
  EXIT CODE(12)
END
SET STATUS = &SYSDSN('&SYSUID..ENUM.REXXLIB')
IF &STR(&STATUS) NE &STR(DATASET NOT FOUND) THEN DO
  WRITE CANNOT CONFIRM &SYSUID..ENUM.REXXLIB IS ABSENT: &STATUS
  EXIT CODE(12)
END
SET STATUS = &SYSDSN('&SYSUID..ENUM.UNIXTAR')
IF &STR(&STATUS) NE &STR(DATASET NOT FOUND) THEN DO
  WRITE CANNOT CONFIRM &SYSUID..ENUM.UNIXTAR IS ABSENT: &STATUS
  EXIT CODE(12)
END
RECEIVE INDATASET('&SYSUID..ENUM.XMILIB(LOADLIB)')
DATA PROMPT
  DATASET('&SYSUID..ENUM.LOADLIB')
ENDDATA
IF &LASTCC NE 0 THEN EXIT CODE(&LASTCC)
RECEIVE INDATASET('&SYSUID..ENUM.XMILIB(JCLLIB)')
DATA PROMPT
  DATASET('&SYSUID..ENUM.JCLLIB')
ENDDATA
IF &LASTCC NE 0 THEN EXIT CODE(&LASTCC)
RECEIVE INDATASET('&SYSUID..ENUM.XMILIB(SOURCE)')
DATA PROMPT
  DATASET('&SYSUID..ENUM.SOURCE')
ENDDATA
IF &LASTCC NE 0 THEN EXIT CODE(&LASTCC)
RECEIVE INDATASET('&SYSUID..ENUM.XMILIB(REXXLIB)')
DATA PROMPT
  DATASET('&SYSUID..ENUM.REXXLIB')
ENDDATA
IF &LASTCC NE 0 THEN EXIT CODE(&LASTCC)
RECEIVE INDATASET('&SYSUID..ENUM.XMILIB(UNIXTAR)')
DATA PROMPT
  DATASET('&SYSUID..ENUM.UNIXTAR')
ENDDATA
IF &LASTCC NE 0 THEN EXIT CODE(&LASTCC)
WRITE ENUM INSTALLED: LOADLIB JCLLIB SOURCE REXXLIB UNIXTAR.
EXIT CODE(0)
